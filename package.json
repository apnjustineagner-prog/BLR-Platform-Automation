{
  "name": "blr-platform-automation",
  "version": "1.0.0",
  "description": "QA Automation Template — Playwright + TypeScript + Faker + Qase",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:retry": "playwright test --retries=3",
    "test:ui:retry": "playwright test --ui --retries=3",
    "format": "prettier --write \"**/*.ts\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.ts\" --ignore-path .prettierignore"
  },
  "keywords": [
    "playwright",
    "qa",
    "automation",
    "testing"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@faker-js/faker": "^8.4.1",
    "dotenv": "^16.6.1",
    "googleapis": "^171.4.0",
    "imapflow": "^1.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^10.2.0",
    "playwright-qase-reporter": "^2.5.0",
    "prettier": "^3.8.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
